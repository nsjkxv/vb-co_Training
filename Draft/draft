.checkbox-input {
    appearance: none;
    position: relative;
    width: 16px;
    height: 16px;
    background: transparent;
    box-shadow: inset 0 0 0 2px #0A9A5C;
    border-radius: 4px;
    border: 1px solid #ffffff;
    transition: 500ms;
}

.checkbox-input::after {
    content: "\2714";
    position: absolute;
    top: -5px;
    left: 2px;
    width: 0;
    height: 0;
    font-size: 26px;
    transition: 500ms;
    overflow: hidden;
}

.checkbox-input::after {
    content: "";
    position: absolute;
    width: 0;
    height: 0;
    font-size: 30px;
    background-image: url("../../content/icons/check-mark.svg");
    background-repeat: no-repeat;
    transition: 500ms;
}

.checkbox-input:checked::after {
    width: 16px;
    height: 16px;
    transition: 500ms;
}

.checkbox-input:disabled {
    background: #ccc;
    border-color: #ccc;
}

.checkbox-input:disabled::after {
    filter: grayscale(100%);
}